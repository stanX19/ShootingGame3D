3. tags::faction::{
		ally,
		enemy,
		other1,
		other2,
	}
	enemies = registry.view<tag::Targetable>(entt::exclude<MyTag>)

	// abusing std::tuple, std::apply, and fold expression and decltype to iterate through types
	using AllFactionTags = std::tuple<Ally, Enemy, Neutral, Other1, Other2>;
	AllFactionTags allFactionTags;

	std::apply([&](auto... tag_type) { ( {
		enemies registry.view<decltype(tag_type)>(entt::exclude<decltype(tag_type)>)
	}, ...) }, allFactionTags)

